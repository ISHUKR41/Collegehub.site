# ================================================================
# CollegeHub Backend Environment Template
# Copy this file to .env and provide real production values.
# ================================================================

# Runtime
PORT=5000
NODE_ENV=development
BODY_LIMIT=10kb

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/collegehub?retryWrites=true&w=majority

# Redis (optional but recommended for caching)
# Leave empty to run without Redis.
REDIS_URL=redis://default:<password>@<host>:<port>

# JWT Security
JWT_ACCESS_SECRET=replace-with-random-64-char-secret
JWT_REFRESH_SECRET=replace-with-random-64-char-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_PATH=/api/auth

# CORS (comma-separated allowed origins)
CORS_ORIGIN=http://localhost:3000

# Optional: Set to enable secure admin self-registration flow.
# If empty, users cannot register directly as admin.
ADMIN_INVITE_CODE=

# Optional seed-script overrides.
SEED_ADMIN_EMAIL=admin@collegehub.site
SEED_ADMIN_PASSWORD=ChangeMe@1234
SEED_FORCE_ADMIN_PASSWORD_RESET=false
